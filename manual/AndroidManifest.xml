<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hawchou.gomoku"
    android:versionCode="21"
    android:versionName="1.2.9">

    <!-- 手工构建无 AGP 注入：必须显式声明，否则部分 ROM 报「应用与手机不兼容」；
         minSdk 24 与坦克一致，兼容 Android 7.0+；图标已补 mipmap-* 多密度 PNG 低版本回退 -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- 联机模式（PeerJS WebRTC + 信令）需要网络；单机对战不受影响 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="五子棋"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
